{
  "name": "siben-root",
  "version": "1.0.0",
  "private": true,
  "description": "Siben - Disaster Preparedness Website",
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run start --prefix backend",
    "client": "npm run start --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --legacy-peer-deps --prefix frontend",
    "install:all": "concurrently \"npm run install:backend\" \"npm run install:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

